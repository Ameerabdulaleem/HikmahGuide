# Copy to .env for local development. Never commit the real file (it is in .gitignore).

# Groq API key for the writing model. Without it the app still works: answers are then
# compiled directly from the verified sources instead of being written by the model.
GROQ_API_KEY=

# Optional. Defaults to llama-3.3-70b-versatile.
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional. Defaults to https://api.alquran.cloud/v1 (change only to point at a mirror).
# QURAN_API_BASE=https://api.alquran.cloud/v1
